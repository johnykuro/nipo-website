---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuBrowser from "../components/MenuBrowser.astro";
import FoodMenu from "../components/FoodMenu.astro";
import { mainSections } from "../data/menus";
---
<BaseLayout title="Menus | NIPO Newcastle" description="Explore NIPO’s main menu with prices, desserts, cocktails, drinks and wine. Sushi, robata and Japanese-Brazilian dishes on Newcastle Quayside.">
  <main id="main-content">
    <MenuBrowser />
    <FoodMenu id="main-menu" title="Main Menu" intro="Sushi, small plates and dishes from the fire. Made to discover, made to share." pdfHref="/menus/nipo-main.pdf" sections={mainSections} />
  </main>
</BaseLayout>
