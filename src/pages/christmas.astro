---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import FoodMenu from "../components/FoodMenu.astro";
import { photo } from "../data/media";
import { festiveSections } from "../data/festive-menu";
import { christmasVenues, christmasEnquiryHref } from "../config/christmas";
---
<BaseLayout title="Christmas Dining & Festive Menu | NIPO Newcastle & Harrogate" description="Celebrate Christmas at NIPO in Newcastle and Harrogate. Three courses £55 or four £65, for a table for two, family dining, friends or your office Christmas party.">
  <main id="main-content" class="christmas-page" data-christmas-page>
      <div class="christmas-snow" aria-hidden="true" data-christmas-snow hidden>
        {Array.from({ length: 32 }, (_, index) => <span style={`--x:${(index * 37 + 11) % 100}%;--size:${2 + index % 3}px;--duration:${15 + index % 11}s;--delay:-${index * 1.7}s;--drift:${(index % 5 - 2) * 18}px;--alpha:${0.25 + index % 4 * 0.12}`} />)}
      </div>
    <button class="snow-control" type="button" data-snow-toggle hidden>Pause snowfall</button>
    <section class="christmas-hero" aria-labelledby="christmas-title" data-christmas-hero>
      <div class="christmas-hero__image"><Photo asset={photo("christmas-steak")} eager /></div>
      <div class="christmas-hero__copy">
        <h1 id="christmas-title">Christmas<br />at <span>NIPO</span></h1>
        <p class="christmas-hero__locations">Newcastle Quayside &amp; Harrogate</p>
        <p class="christmas-hero__intro">Gather your favourite people.<br />Make a little more of Christmas.</p>
        <p class="christmas-hero__prices">Three courses <strong>£55</strong><span aria-hidden="true"> / </span><br class="mobile-break" />Four courses <strong>£65</strong></p>
        <div class="christmas-actions">
          <a class="button button--booking" href="#christmas-enquiries">Book your Christmas table</a>
          <a class="text-link" href="#festive-menu">Explore the festive menu</a>
        </div>
      </div>
    </section>

    <section class="christmas-parties section-shell" aria-labelledby="parties-title">
      <div class="christmas-parties__copy">
        <h2 id="parties-title">Festive dining<br />at NIPO</h2>
        <p>Choose three or four courses from our festive menu, with sushi, robata-grilled fillet, slow-cooked lamb and desserts to finish.</p>
        <p>Join us in Newcastle or Harrogate for dinner for two, a meal with friends or a family get-together. The festive menu is available for regular dining tables as well as larger celebrations.</p>
        <a class="text-link" href="#festive-menu">See the festive menu</a>
      </div>
      <div class="christmas-parties__image"><Photo asset={photo("christmas-wine")} sizes="(max-width:767px) 100vw, 40vw" /></div>
    </section>

    <FoodMenu id="festive-menu" title="A taste of NIPO at Christmas" locationLabel="Newcastle Quayside & Harrogate"
      intro="Festive set menu · Three courses £55 / Four courses £65"
      pdfHref="/menus/nipo-festive.pdf" pdfLabel="View festive menu PDF" sections={festiveSections}
      closingAction={{ href: "#christmas-enquiries", label: "Book your Christmas table" }}>
      <p class="festive-menu-note">V — Vegetarian · VG — Vegan<br />Contact our team for festive availability and group arrangements.</p>
    </FoodMenu>

    <section class="christmas-groups section-shell" id="christmas-parties" aria-labelledby="groups-title">
      <div>
        <h2 id="groups-title">Office Christmas parties<br />&amp; larger gatherings</h2>
        <p>Organising this year’s office meal or bringing a larger group together? Celebrate at NIPO in Newcastle or Harrogate with our festive set menu.</p>
      </div>
      <div class="christmas-groups__enquiry">
        <p>Tell us your preferred date, restaurant and number of guests. Our team will help with availability and group arrangements.</p>
        <div class="christmas-groups__actions">
          {christmasVenues.map(venue => <a class="button christmas-groups__button" href={christmasEnquiryHref(venue, "party")}>Enquire for {venue.id === "newcastle" ? "Newcastle" : "Harrogate"}</a>)}
        </div>
      </div>
    </section>

    <section class="christmas-enquiries section-shell" id="christmas-enquiries" tabindex="-1" aria-labelledby="enquiries-title">
      <div class="christmas-enquiries__intro">
        <h2 id="enquiries-title">Book your<br />Christmas table</h2>
        <div><p>Join us for a festive meal, from a table for two to a celebration with friends and family.</p><p>Book a Newcastle table online, or contact your chosen restaurant for festive availability. For office parties and larger groups, include your preferred date and number of guests.</p></div>
      </div>
      <div class="christmas-venues">
        {christmasVenues.map(venue => <section class="christmas-venue" aria-labelledby={`christmas-${venue.id}`}>
          <h3 id={`christmas-${venue.id}`}>{venue.name}</h3>
          <p>Festive dining &amp; Christmas celebrations</p>
          <a class="christmas-venue__email" href={christmasEnquiryHref(venue)}>{venue.email}</a>
          {venue.telephone && <a class="christmas-venue__phone" href={`tel:${venue.telephone}`}>{venue.telephoneDisplay}</a>}
          <div class="christmas-venue__actions">
            {venue.bookingUrl && <a class="button button--booking" href={venue.bookingUrl}>Book a Newcastle table</a>}
            <a class={venue.bookingUrl ? "text-link" : "button button--booking"} href={christmasEnquiryHref(venue)}>Enquire for {venue.id === "newcastle" ? "Newcastle" : "Harrogate"}</a>
          </div>
        </section>)}
      </div>
    </section>
  </main>
</BaseLayout>
<script>import "../scripts/christmas-snow";</script>
<style>
  .christmas-hero { position: relative; isolation: isolate; min-height: min(780px, calc(100svh - var(--header))); display: grid; align-items: center; background: var(--night-deep); overflow: hidden; }
  .christmas-hero__image { position: absolute; inset: 0; z-index: -3; }
  .christmas-hero::before { content: ""; position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(11,22,18,.94), rgba(11,22,18,.76) 30%, rgba(11,22,18,.12) 70%); }
  .christmas-hero__copy { width: min(100%, 780px); padding: 80px var(--gutter) 95px; }
  .christmas-hero h1 { font-size: clamp(64px, 6.6vw, 96px); line-height: 1.04; margin: 0 0 28px; }
  .christmas-hero h1 span { color: var(--gold); }
  .christmas-hero__locations { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .christmas-hero__intro { margin: 26px 0; font-size: 18px; line-height: 1.65; }
  .christmas-hero__prices { font-size: 15px; font-variant-numeric: tabular-nums; }
  .christmas-hero__prices strong { font-weight: 500; }
  .christmas-hero__prices > span { padding: 0 10px; color: var(--gold); }
  .mobile-break { display: none; }
  .christmas-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; margin-top: 32px; }
  .christmas-actions .button { line-height: 1.6; text-align: center; }
  .christmas-snow { position: fixed; inset: 0; z-index: 30; pointer-events: none; overflow: hidden; mix-blend-mode: difference; }
  .christmas-snow span { position: absolute; top: -12px; left: var(--x); width: var(--size); height: var(--size); border-radius: 50%; background: var(--ivory); opacity: var(--alpha); animation: snowfall var(--duration) var(--delay) linear infinite; animation-play-state: paused; }
  [data-snow-running="true"] .christmas-snow span { animation-play-state: running; }
  .snow-control { position: fixed; z-index: 45; right: 24px; bottom: 20px; min-height: 44px; padding: 10px 16px; background: transparent; color: var(--ivory); border: 1px solid currentColor; font-size: 12px; font-weight: 500; letter-spacing: .04em; text-shadow: 0 1px 2px #000, 1px 0 1px #000, -1px 0 1px #000; }
  .snow-control[data-snow-surface="light"] { color: var(--night); text-shadow: none; }
  .snow-control:hover { text-decoration: underline; text-underline-offset: 4px; }
  .snow-control[hidden], .christmas-snow[hidden] { display: none; }
  @keyframes snowfall { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(var(--drift), var(--snow-travel, 850px), 0); } }
  .christmas-parties { display: grid; grid-template-columns: 1.1fr 1fr; gap: 10%; align-items: center; padding-block: var(--space); }
  .christmas-parties h2, .christmas-enquiries h2 { font-size: clamp(38px, 4vw, 60px); line-height: 1.12; margin-bottom: 32px; }
  .christmas-parties em, .christmas-enquiries em { font-style: italic; color: var(--gold); }
  .christmas-parties__copy p { max-width: 49ch; font-size: 16px; }
  .christmas-parties__copy .text-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 12px; }
  .christmas-parties__image { aspect-ratio: 4 / 5; }
  .festive-menu-note { text-align: center; font-size: 13px; line-height: 1.9; max-width: 650px; margin: 0 auto 40px; }
  .christmas-groups { display: grid; grid-template-columns: 1.1fr 1fr; gap: 10%; padding-block: var(--space); background: #241e1c; }
  .christmas-groups h2 { font-size: clamp(34px, 3.5vw, 50px); line-height: 1.15; margin-bottom: 28px; }
  .christmas-groups p { font-size: 16px; max-width: 49ch; }
  .christmas-groups__enquiry { align-self: center; }
  .christmas-groups__actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; }
  .christmas-groups__button { border: 1px solid var(--gold); color: var(--gold); background: transparent; }
  .christmas-groups__button:hover { color: var(--night); background: var(--gold); }
  .christmas-enquiries { padding-block: var(--space); }
  .christmas-enquiries__intro { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; align-items: center; margin-bottom: 48px; }
  .christmas-enquiries__intro h2 { margin-bottom: 0; }
  .christmas-enquiries__intro p { max-width: 48ch; font-size: 16px; }
  .christmas-venues { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; }
  .christmas-venue { padding-top: 36px; border-top: 1px solid var(--line); min-width: 0; }
  .christmas-venue h3 { font-size: 30px; margin-bottom: 12px; }
  .christmas-venue p { font-size: 13px; color: var(--muted); margin-bottom: 18px; }
  .christmas-venue__email, .christmas-venue__phone { display: flex; align-items: center; min-height: 44px; font-size: 16px; text-decoration: underline; text-underline-offset: 5px; overflow-wrap: anywhere; }
  .christmas-venue__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-top: 28px; }
  .christmas-venue__actions .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 767px) {
    .christmas-hero { min-height: 0; display: flex; flex-direction: column; align-items: stretch; }
    .christmas-hero__copy { order: -1; width: 100%; padding: 54px 24px 44px; }
    .christmas-hero h1 { font-size: clamp(58px, 12vw, 80px); margin-bottom: 24px; }
    .christmas-hero__locations { font-size: 10px; letter-spacing: .08em; }
    .christmas-hero__intro { font-size: 16px; margin-block: 22px; }
    .christmas-hero__prices { font-size: 14px; }
    .christmas-hero__prices > span { padding-inline: 5px; }
    .christmas-hero__image { position: relative; inset: auto; aspect-ratio: 16 / 10; z-index: 0; }
    .christmas-hero::before { display: none; }
    .christmas-snow span:nth-child(n+15) { display: none; }
    .snow-control { right: 16px; bottom: 16px; }
    .christmas-actions { margin-top: 28px; gap: 22px; }
    .christmas-actions .button { width: 100%; padding-inline: 12px; font-size: 10px; letter-spacing: .08em; }
    .christmas-parties { grid-template-columns: 1fr; gap: 40px; }
    .christmas-parties__image { max-width: 480px; width: 100%; justify-self: center; }
    .christmas-enquiries__intro, .christmas-venues { grid-template-columns: 1fr; gap: 36px; }
    .christmas-groups { grid-template-columns: 1fr; gap: 16px; }
    .christmas-enquiries__intro { margin-bottom: 24px; }
    .christmas-venue__email { font-size: 15px; }
    .christmas-page :global(#festive-menu .menu-dish p:not(.menu-dish__exclusive)) { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .christmas-snow, .snow-control { display: none; }
    .christmas-snow span { animation: none; }
  }
</style>
