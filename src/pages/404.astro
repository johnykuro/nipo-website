---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | NIPO"
  description="The page you were looking for could not be found."
  noIndex
>
  <main class="not-found" id="main-content">
    <img src="/brand/nipo-logo.svg" alt="NIPO" width="455" height="401" />
    <p class="eyebrow">404 · After dark</p>
    <h1>This table<br /><em>isn’t set.</em></h1>
    <p>The page you’re looking for has moved or never existed.</p>
    <a class="button button--ivory" href="/">Return to NIPO</a>
  </main>
</BaseLayout>
