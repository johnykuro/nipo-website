---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import Faq from "../../components/Faq.astro";
import VipSignup from "../../components/VipSignup.astro";
import { photo } from "../../data/media";
import { harrogate } from "../../config/locations";
import { harrogateFaqs } from "../../config/faqs";
---
<BaseLayout location={harrogate} title="NIPO Harrogate | Japanese-Brazilian Steakhouse" description="A new Japanese-Brazilian steakhouse is coming to Harrogate. Discover NIPO’s robata-style cooking, steak and sushi craft. Join our VIP list for opening news." image="/images/harrogate-social.png" imageAlt="NIPO Harrogate — Japanese-Brazilian steakhouse. Coming soon.">
  <main id="main-content">
    <section class="harrogate-opening">
      <div class="harrogate-opening__copy">
        <p class="label">Harrogate · Coming soon</p>
        <h1>A new Japanese-Brazilian steakhouse for Harrogate.</h1>
        <p class="lead">Japanese Precision.<br />Brazilian Fire.</p>
        <p>NIPO is bringing a new Japanese-Brazilian steakhouse experience to Parliament Street. Robata-style cooking and steak take centre stage, alongside sushi craft and warm Brazilian hospitality.</p>
        <a class="button button--booking" href="#newsletter">Join the Harrogate VIP list</a>
        <p class="harrogate-opening__status">Opening date to be announced</p>
      </div>
      <Photo asset={photo("hero-sliced-steak")} eager sizes="(max-width:767px) 100vw, 50vw" />
    </section>
    <section class="editorial-feature editorial-feature--ivory">
      <Photo asset={photo("steak-on-fire")} sizes="(max-width:767px) 100vw, 50vw" />
      <div class="editorial-feature__copy" data-reveal><p class="label">The fire at the heart of NIPO</p><h2>Steak. Fire.<br />Japanese craft.</h2><p>Our approach to the steakhouse brings Japanese attention to detail together with Brazilian warmth. Robata-style cooking puts the grill at the heart of the experience, bringing depth, char and care to every plate.</p><p>Alongside the fire, sushi craft offers balance and contrast. It is an invitation to explore different flavours, pass a plate and take your time together.</p></div>
    </section>
    <section class="editorial-feature editorial-feature--reverse">
      <Photo asset={photo("sushi-chopsticks")} sizes="(max-width:767px) 100vw, 50vw" />
      <div class="editorial-feature__copy" data-reveal><p class="label">Two cultures. One table.</p><h2>A new expression.<br />A familiar warmth.</h2><p>From the team behind Rio Brazilian Steakhouse, NIPO brings a new expression of fire, flavour and food made for sharing.</p><p>Inspired by the Nipo-Brasileiro community of São Paulo, our Japanese-Brazilian identity celebrates craft, generosity and the pleasure of a shared table. We look forward to bringing that welcome to Harrogate.</p><a class="text-link" href="/concept/">Discover the NIPO story</a></div>
    </section>
    <section class="harrogate-address section-shell" aria-labelledby="harrogate-address-title">
      <div><p class="label">Our next chapter</p><h2 id="harrogate-address-title">Coming to<br />Parliament Street.</h2></div>
      <div><address>{harrogate.address.street}<br />{harrogate.address.city} {harrogate.address.postcode}</address><p>Join the Harrogate VIP list for opening news as plans take shape.</p><p class="harrogate-photo-note">Food photography from NIPO Newcastle Quayside.</p></div>
    </section>
    <Faq items={harrogateFaqs} />
    <VipSignup location="harrogate" />
  </main>
</BaseLayout>
<style>
  .harrogate-opening { display: grid; grid-template-columns: 1fr 1fr; }
  .harrogate-opening__copy { padding: clamp(44px, 6vw, 100px) var(--gutter); }
  .harrogate-opening h1 { font-size: clamp(37px, 3.8vw, 62px); line-height: 1.1; margin-bottom: 32px; max-width: 700px; }
  .harrogate-opening__copy > p:not(.label):not(.lead) { color: var(--muted); max-width: 560px; }
  .harrogate-opening > :global(.photo) { min-height: 600px; }
  .harrogate-opening .button { margin-top: 12px; }
  .editorial-feature--ivory .label { color: var(--night); }
  .harrogate-opening__status { font-size: 12px; margin: 18px 0 0; }
  .harrogate-address { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-block: var(--space); }
  .harrogate-address h2 { font-size: clamp(34px, 4vw, 56px); }
  .harrogate-address address { font-style: normal; font-size: 24px; line-height: 1.6; margin-bottom: 24px; }
  .harrogate-photo-note { font-size: 12px; color: var(--muted); }
  @media(max-width:767px) { .harrogate-opening, .harrogate-address { grid-template-columns: 1fr; } .harrogate-opening > :global(.photo) { min-height: 0; aspect-ratio: 4 / 3; } .harrogate-address { gap: 24px; } }
</style>
