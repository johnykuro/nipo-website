---
import type { SocialPlatform } from "../config/site";

interface Props {
  platform: SocialPlatform;
}

const { platform } = Astro.props;
---

<svg viewBox="0 0 24 24" width="20" height="20" fill={platform === "Instagram" ? "none" : "currentColor"} aria-hidden="true" focusable="false">
  {platform === "Facebook" && (
    <path d="M13.5 22v-9h3l.5-3.5h-3.5V7.25c0-1.01.28-1.7 1.75-1.7H17V2.42A23.4 23.4 0 0 0 14.45 2C11.92 2 10 3.55 10 6.4v3.1H7V13h3v9h3.5Z" />
  )}
  {platform === "Instagram" && (
    <g stroke="currentColor" stroke-width="1.8">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </g>
  )}
  {platform === "TikTok" && (
    <path d="M16.6 2H13v13.5a3 3 0 1 1-2.5-2.96V8.9a6.6 6.6 0 1 0 6.1 6.6V8.7a9.1 9.1 0 0 0 5.4 1.75v-3.6A5.4 5.4 0 0 1 16.6 2Z" />
  )}
</svg>
