<section class="cookie-banner" data-cookie-banner role="region" aria-labelledby="cookie-title" hidden>
  <div class="cookie-banner__copy">
    <h2 id="cookie-title" tabindex="-1">Your cookie choices</h2>
    <p>We use essential technology to keep this site working and protect our forms. With your permission, we also use optional cookies for analytics and marketing. You can change your choice at any time in Cookie settings. <a href="/privacy/#cookies">Read our cookie policy</a>.</p>
    <div class="cookie-preferences" id="cookie-preferences" data-cookie-preferences hidden>
      <label><input type="checkbox" data-cookie-analytics /> <span><strong>Analytics</strong> — help us improve the website using visit statistics, heatmaps and session recordings.</span></label>
      <label><input type="checkbox" data-cookie-marketing /> <span><strong>Marketing</strong> — measure advertising and personalise ads.</span></label>
      <p>Essential technology is always enabled. Your choice is remembered for up to six months.</p>
    </div>
  </div>
  <div class="cookie-banner__actions">
    <button type="button" data-cookie-accept>Accept all</button>
    <button type="button" data-cookie-reject>Reject optional</button>
    <button type="button" data-cookie-manage aria-expanded="false" aria-controls="cookie-preferences">Manage choices</button>
    <button type="button" data-cookie-save hidden>Save choices</button>
  </div>
</section>
<p class="sr-only" role="status" data-cookie-status></p>
<script>import "../scripts/consent";</script>
