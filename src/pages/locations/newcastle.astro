---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import Faq from "../../components/Faq.astro";
import LocationMap from "../../components/LocationMap.astro";
import { photo } from "../../data/media";
import { siteConfig } from "../../config/site";
import { newcastle as config } from "../../config/locations";
import { newcastleFaqs } from "../../config/faqs";
---
<BaseLayout location={config} title="NIPO Newcastle Quayside | Japanese-Brazilian Restaurant" description="Find NIPO at 95 Quayside, Newcastle upon Tyne NE1 3DH. Book a table at our Japanese-Brazilian restaurant, get directions and find answers to common questions." image="/images/social-card.png">
  <main id="main-content">
    <section class="contact-opening">
      <div class="contact-opening__copy"><p class="label">Newcastle Quayside</p><h1>NIPO<br />Newcastle Quayside.</h1>
        <address>{config.address.street}<br />{config.address.city}<br />{config.address.postcode}</address>
        <div class="contact-details">
          <p><a href={"tel:" + config.telephone}>{config.telephoneDisplay}</a><br /><a href={"mailto:" + config.email}>{config.email}</a></p>
          <p><strong>Opening hours</strong>{config.hours.map((hours) => <Fragment><br />{hours.label}</Fragment>)}</p>
        </div>
        <div class="action-row"><a class="button button--booking" href={config.bookingUrl}>Book a table</a><a class="text-link" href={config.address.directionsUrl} target="_blank" rel="noopener noreferrer">Get directions</a><a class="text-link" href="/menus/">Newcastle menus</a></div>
        <div class="contact-socials">{siteConfig.socialLinks.filter((item) => item.url).map((item) => <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label}</a>)}</div>
      </div>
      <Photo asset={photo("sushi-table")} eager sizes="(max-width:767px) 100vw, 50vw" />
    </section>
    <LocationMap location={config} />
    <Faq items={newcastleFaqs} />
    <div class="booking-band section-shell"><h2>A little more NIPO.</h2><a class="text-link" href="/#newsletter">Join our newsletter</a></div>
  </main>
</BaseLayout>
