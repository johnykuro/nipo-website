{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "tmp", "output", "coverage"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "types": ["@cloudflare/workers-types", "vitest/globals"]
  }
}
