---
import Photo from "./Photo.astro";
import { photo } from "../data/media";
import { locations } from "../config/locations";
interface Props { showHeading?: boolean }
const { showHeading = true } = Astro.props;
---
<section class="locations-section section-shell" aria-label="NIPO locations">
  {showHeading && <div class="locations-heading" data-reveal><p class="label">Find your NIPO</p><h2>Two places.<br />One generous welcome.</h2></div>}
  <div class="location-cards">
    {locations.map(place => <article class="location-card" data-reveal>
      <a class="location-card__image" href={place.path} tabindex="-1" aria-hidden="true"><Photo asset={photo(place.id === "newcastle" ? "sushi-table" : "sliced-steak")} sizes="(max-width:767px) 100vw, 50vw" decorative /></a>
      <div class="location-card__copy"><p class="label">{place.status === "open" ? "Open · Newcastle upon Tyne" : "Coming soon · North Yorkshire"}</p><h2><a href={place.path}>{place.name}</a></h2><p>{place.id === "newcastle" ? "Japanese precision and Brazilian warmth on the Quayside. Settle in for sushi, robata and dishes made for sharing." : "A new Japanese-Brazilian steakhouse for Harrogate. Discover robata-style cooking, steak and a generous welcome."}</p><a class="text-link" href={place.path}>{place.id === "newcastle" ? "Discover Newcastle" : "Discover Harrogate"}</a></div>
    </article>)}
  </div>
</section>
<style>
  .locations-section { padding-block: var(--space); }
  .locations-heading { margin-bottom: 48px; }
  .locations-heading h2 { font-size: clamp(34px, 4vw, 56px); }
  .location-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .location-card__image { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .location-card__image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .location-card__copy { padding-top: 30px; }
  .location-card__copy h2 { font-size: clamp(30px, 3vw, 44px); margin-bottom: 20px; }
  .location-card__copy p:not(.label) { max-width: 490px; color: var(--muted); }
  @media(max-width:767px) { .location-cards { grid-template-columns: 1fr; gap: 52px; } .locations-heading { margin-bottom: 32px; } }
</style>
