---
import { siteConfig } from "../config/site";
import SocialLinks from "./SocialLinks.astro";
import { newcastle, type RestaurantLocation } from "../config/locations";
interface Props { overlay?: boolean; location?: RestaurantLocation }
const { overlay = false, location } = Astro.props;
const isHarrogate = location?.id === "harrogate";
const bookingHref = isHarrogate ? "#newsletter" : newcastle.bookingUrl;
const bookingLabel = isHarrogate ? "Join the Harrogate VIP list" : location?.id === "newcastle" ? "Book a table" : "Book Newcastle";
const navigation = siteConfig.navigation.filter(link => !isHarrogate || link.href !== "/menus/");
const path = Astro.url.pathname;
---
<header class:list={["site-header", { "site-header--overlay": overlay }]} data-site-header>
  <a class="header-brand" href="/" aria-label="NIPO home"><img src="/brand/nipo-mark.svg" width="48" height="46" alt="NIPO" /></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {navigation.map((link) => <a href={link.href} aria-current={(path === link.href || (link.href === "/locations/" && path.startsWith("/locations/"))) ? "page" : undefined}>{link.label}</a>)}
    <SocialLinks />
  </nav>
  <div class="header-actions">
    <a class="button button--booking header-book" href={bookingHref}>{bookingLabel}</a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span aria-hidden="true">☰</span></button>
  </div>
</header>
<nav class="no-js-nav" aria-label="Page navigation">{navigation.map((link) => <a href={link.href}>{link.label}</a>)}<SocialLinks /></nav>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation" data-mobile-menu>
  <div class="mobile-menu__top"><img src="/brand/nipo-mark.svg" alt="NIPO" width="48" height="46" /><button type="button" data-menu-close>Close <span aria-hidden="true">×</span></button></div>
  <nav aria-label="Mobile navigation"><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
    {navigation.map((link) => <a href={link.href} aria-current={(path === link.href || (link.href === "/locations/" && path.startsWith("/locations/"))) ? "page" : undefined}>{link.label}</a>)}
    <div class="mobile-menu__socials"><SocialLinks /></div>
  </nav>
  <div class="mobile-menu__bottom"><a class="button button--booking" href={bookingHref}>{bookingLabel}</a><p><a href="/locations/newcastle/">Newcastle Quayside · Open</a><br /><a href="/locations/harrogate/">Harrogate · Coming soon</a></p></div>
</dialog>
