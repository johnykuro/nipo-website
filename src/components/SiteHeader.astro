---
import { siteConfig } from "../config/site";
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={["site-header", { "site-header--overlay": overlay }]} data-site-header>
  <a class="header-brand" href="/" aria-label="NIPO home"><img src="/brand/nipo-mark.svg" width="48" height="46" alt="NIPO" /></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {siteConfig.navigation.map((link) => <a href={link.href} aria-current={path === link.href ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="button button--ivory header-book" href={siteConfig.bookingUrl}>Book a table</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>Menu <span aria-hidden="true">☰</span></button>
  </div>
</header>
<nav class="no-js-nav" aria-label="Page navigation">{siteConfig.navigation.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Main navigation" data-mobile-menu>
  <div class="mobile-menu__top"><img src="/brand/nipo-mark.svg" alt="NIPO" width="48" height="46" /><button type="button" data-menu-close>Close <span aria-hidden="true">×</span></button></div>
  <nav aria-label="Mobile navigation"><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
    {siteConfig.navigation.map((link) => <a href={link.href} aria-current={path === link.href ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <div class="mobile-menu__bottom"><a class="button button--ivory" href={siteConfig.bookingUrl}>Book a table</a><p>95 Quayside<br />Newcastle upon Tyne</p></div>
</dialog>
