---
import { siteConfig, openingLine } from "../config/site";
import { photo } from "../data/media";
import Photo from "./Photo.astro";
const slides = siteConfig.hero.slideIds.map(photo);
const useVideo = siteConfig.hero.mode === "video" && siteConfig.video.src;
---
<section class="hero" aria-label="Welcome to NIPO" aria-roledescription="carousel" data-hero data-interval={siteConfig.hero.interval} data-video-src={useVideo ? siteConfig.video.src : undefined}>
  <div class="hero-media" aria-hidden="true">
    {slides.map((asset, index) => <div class:list={["hero-slide", { "is-active": index === 0 }]} data-hero-slide><Photo asset={asset} eager={index === 0} decorative /></div>)}
    {useVideo && <video class="hero-video" poster={siteConfig.video.poster} muted loop playsinline preload="none" tabindex="-1"></video>}
  </div>
  <div class="hero-veil"></div>
  <div class="hero-content">
    <div class="hero-logo"><img src="/brand/nipo-logo-compact.svg" width="455" height="367" alt="NIPO" fetchpriority="high" /></div>
    <h1>Japanese Precision.<br />Brazilian Fire.</h1>
    <p class="hero-location">{openingLine} <span aria-hidden="true">·</span> Newcastle Quayside</p>
    <a class="button button--ivory" href="/menus/">Discover the menus <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hero-bottom"><a class="hero-scroll" href="#welcome">Scroll to discover <span aria-hidden="true">↓</span></a>
    <div class="slideshow-controls" aria-label="Slideshow controls" data-slideshow-controls hidden>
      <button type="button" data-hero-prev aria-label="Previous photograph">←</button><span data-hero-count>01 / 03</span><button type="button" data-hero-next aria-label="Next photograph">→</button><button type="button" data-hero-pause aria-pressed="false">Pause</button>
    </div>
  </div>
</section>
