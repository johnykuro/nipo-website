---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const title = "Privacy policy | NIPO";
const description =
  "How NIPO collects, uses and protects personal information from website visitors and restaurant guests.";
const lastUpdated = "17 September 2026";
---

<BaseLayout title={title} description={description}>
  <main class="legal-page" id="main-content">
    <div class="legal-page__intro">
      <p class="eyebrow">Privacy policy</p>
      <h1>Your details,<br /><em>treated with care.</em></h1>
      <p class="legal-page__review">Last updated: {lastUpdated}</p>
    </div>

    <div class="legal-copy">
      <section>
        <h2>1. Introduction</h2>
        <p>
          NIPO respects your privacy and is committed to protecting your personal
          information. This policy explains how we collect and use that information,
          the circumstances in which we may share it, and the rights available to you.
        </p>
        <p>
          NIPO is the controller responsible for the personal information covered by
          this policy. It applies when you visit our website or restaurant, contact us,
          join our mailing list, make a booking, place an order or use a service we make
          available to guests.
        </p>
      </section>

      <section>
        <h2>2. Information we collect</h2>
        <p>We may collect information including:</p>
        <ul>
          <li>your name and contact details;</li>
          <li>booking, order, payment and visit information;</li>
          <li>your marketing and communication preferences;</li>
          <li>information you give us in enquiries, feedback or survey responses;</li>
          <li>
            dietary, allergy or accessibility information you choose to share so we can
            meet your needs;
          </li>
          <li>
            technical information about your device and use of our website, such as an
            IP address, browser type and access time; and
          </li>
          <li>
            images captured by security systems at our premises, where these are in use.
          </li>
        </ul>
        <p>
          We do not usually require information about your health or other sensitive
          matters. Where you choose to provide this information, we use it only where
          necessary to accommodate you or protect your wellbeing.
        </p>
      </section>

      <section>
        <h2>3. How we collect information</h2>
        <p>We collect personal information when you:</p>
        <ul>
          <li>complete a form, join our mailing list or contact us;</li>
          <li>make a booking, order or payment;</li>
          <li>visit the restaurant or use guest services such as Wi-Fi;</li>
          <li>enter a promotion, respond to a survey or give us feedback; or</li>
          <li>use our website, which may generate basic technical and security data.</li>
        </ul>
        <p>
          We may also receive information from organisations that provide booking,
          payment, communications or other services connected with your interaction
          with NIPO.
        </p>
      </section>

      <section>
        <h2>4. Our lawful reasons for using information</h2>
        <p>We use personal information where it is necessary:</p>
        <ul>
          <li>to provide a service or take steps you have requested;</li>
          <li>to meet a legal or regulatory obligation;</li>
          <li>
            for our legitimate business interests, where these do not override your
            rights and freedoms; or
          </li>
          <li>where you have given us consent.</li>
        </ul>
        <p>
          If information is needed to fulfil a booking, order or legal requirement and
          you do not provide it, we may be unable to provide the relevant service.
        </p>
      </section>

      <section>
        <h2>5. How we use information</h2>
        <p>We may use your information to:</p>
        <ul>
          <li>manage bookings, orders, payments and visits;</li>
          <li>answer questions and provide requested information;</li>
          <li>manage our relationship with you and respond to feedback;</li>
          <li>send service messages or important updates;</li>
          <li>send marketing where this is permitted;</li>
          <li>operate, secure and improve our website, premises and services;</li>
          <li>prevent fraud, misuse and other unlawful activity; and</li>
          <li>meet legal, accounting, health and safety obligations.</li>
        </ul>
        <p>
          We do not make solely automated decisions about you that have legal or similarly
          significant effects.
        </p>
      </section>

      <section>
        <h2>6. Marketing</h2>
        <p>
          We may send news, opening updates and offers by email where you have asked us
          to do so or where the law otherwise allows it. You can stop marketing at any
          time by using the unsubscribe link in an email or contacting us.
        </p>
        <p>
          We may retain a limited record of an opt-out so that we can continue to respect
          your preference.
        </p>
      </section>

      <section id="cookies">
        <h2>7. Cookies and similar technology</h2>
        <p>
          We use essential technology to operate the website, remember your cookie
          choices and protect forms with Cloudflare Turnstile. The security check
          processes technical information about your browser and connection to help
          distinguish genuine visitors from automated submissions.
        </p>
        <p>
          Optional analytics helps us understand visits and improve the website.
          Optional marketing measures advertising and may personalise ads. These
          purposes are off until you choose to allow them. You can accept all,
          reject optional cookies, or choose each purpose separately.
        </p>
        <p>
          We store your choice in your browser under <code>nipo-cookie-consent</code>
          for up to 180 days. This preference is essential so that we can respect
          your choice. Google Tag Manager loads only after you accept an optional
          purpose, and Google tags receive your choices for analytics and advertising.
          Without JavaScript, optional tags do not load.
        </p>
        <p>
          Use Cookie settings in the footer to change or withdraw your consent at
          any time. Withdrawing a previously accepted purpose reloads the page to
          stop loaded tags and removes recognised first-party analytics or marketing
          cookies for that purpose. Cookies on other providers’ domains can also be
          removed using your browser’s privacy controls.
        </p>
        <p>
          With analytics consent, we use Google Analytics 4 to measure page visits
          and website usage. It can set first-party cookies such as <code>_ga</code>
          and <code>_ga_*</code>. With marketing consent, we use the Meta Pixel to
          measure visits from our advertising and support advertising audiences.
          It can set <code>_fbp</code> and, after an advertising click,
          <code>_fbc</code>. These services receive information such as the page
          visited, browser and device details, and IP address. Google Analytics
          cookies commonly last up to two years and Meta cookies up to 90 days;
          browser restrictions may shorten these periods.
        </p>
        <p>
          Read more in the <a href="https://policies.google.com/privacy">Google privacy policy</a>
          and <a href="https://www.facebook.com/privacy/policy/">Meta privacy policy</a>.
          Accepting analytics alone does not enable the Meta Pixel. Booking
          completion takes place on SevenRooms and is not measured by these
          website page-view tags.
        </p>
        <p>
          Bookings open on SevenRooms, which provides its own privacy and cookie
          information. Your choices here apply to the NIPO website.
        </p>
      </section>

      <section>
        <h2>8. Sharing your information</h2>
        <p>We may share information where necessary with:</p>
        <ul>
          <li>
            providers supporting bookings, payments, communications, marketing, website
            hosting, security and other business systems;
          </li>
          <li>professional advisers, insurers and auditors;</li>
          <li>tax, regulatory, law enforcement or other public authorities;</li>
          <li>
            a potential buyer or successor if our business or assets are reorganised,
            sold or transferred; and
          </li>
          <li>other parties where you ask us to share information or the law permits it.</li>
        </ul>
        <p>
          We require service providers acting for us to protect personal information and
          use it only for the agreed purpose. We do not sell your personal information.
        </p>
      </section>

      <section>
        <h2>9. International transfers</h2>
        <p>
          Some organisations supporting our services may process information outside the
          United Kingdom. Where data protection law treats this as a restricted transfer,
          we use an approved legal safeguard designed to protect your information. You
          may contact us for further information about these safeguards.
        </p>
      </section>

      <section>
        <h2>10. Security</h2>
        <p>
          We use appropriate organisational and technical measures to protect personal
          information against loss, misuse, unauthorised access, alteration or disclosure.
          Access is limited to people who need the information for legitimate purposes.
        </p>
      </section>

      <section>
        <h2>11. Retention</h2>
        <p>
          We keep personal information only for as long as reasonably necessary for the
          purpose for which it was collected, including to meet legal, tax, accounting,
          regulatory and reporting duties. We may retain information for longer where a
          complaint, dispute or legal claim exists or is reasonably anticipated.
        </p>
        <p>
          When deciding how long to keep information, we consider its nature and
          sensitivity, the risks of misuse, why it is needed and whether the purpose can
          be achieved another way.
        </p>
      </section>

      <section>
        <h2>12. Your rights</h2>
        <p>Depending on the circumstances, you may have the right to:</p>
        <ul>
          <li>request access to your personal information;</li>
          <li>ask us to correct inaccurate or incomplete information;</li>
          <li>ask us to delete or restrict the use of information;</li>
          <li>object to certain uses, including direct marketing;</li>
          <li>receive information you provided in a portable format; and</li>
          <li>withdraw consent where our use is based on consent.</li>
        </ul>
        <p>
          These rights are not absolute. We may ask you to confirm your identity and
          clarify your request before responding. We normally respond within one month
          and do not charge a fee, although the law allows exceptions for certain
          unfounded or excessive requests.
        </p>
      </section>

      <section>
        <h2>13. Third-party links</h2>
        <p>
          Our website may link to websites or services operated by other organisations.
          We do not control their privacy practices. Please read the privacy information
          provided by those organisations when leaving our website.
        </p>
      </section>

      <section>
        <h2>14. Contact and complaints</h2>
        {
          siteConfig.privacyContact ? (
            <p>
              To ask a privacy question or exercise your rights, email{" "}
              <a href={`mailto:${siteConfig.privacyContact}`}>
                {siteConfig.privacyContact}
              </a>
              .
            </p>
          ) : (
            <p>
              To ask a privacy question or exercise your rights, reply to an email from
              NIPO with “Privacy” in the subject line, or write to NIPO,
              {siteConfig.address.street}, {siteConfig.address.city},
              {siteConfig.address.postcode}, United Kingdom.
            </p>
          )
        }
        <p>
          Please contact us first so we have an opportunity to resolve your concern. You
          may also complain to the Information Commissioner’s Office through{" "}
          <a href="https://ico.org.uk/make-a-complaint/data-protection-complaints/" rel="noreferrer">
            ico.org.uk
          </a>{" "}
          or by calling 0303 123 1113.
        </p>
      </section>

      <section>
        <h2>15. Changes to this policy</h2>
        <p>
          We review this policy regularly and may update it when our services, business
          practices or legal duties change. The latest version and update date will be
          published on this page.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
