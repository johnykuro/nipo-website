---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Photo from "../components/Photo.astro";
import GalleryRail from "../components/GalleryRail.astro";
import Lightbox from "../components/Lightbox.astro";
import VipSignup from "../components/VipSignup.astro";
import { photo } from "../data/media";
import { homeTitle, homeDescription } from "../config/seo";
---
<BaseLayout title={homeTitle} description={homeDescription} overlayHeader>
  <main id="main-content">
    <Hero />
    <section class="welcome section-shell" id="welcome">
      <div class="welcome__heading" data-reveal><p class="label">NIPO · Newcastle Quayside</p><h2>Two cultures.<br />One table.</h2></div>
      <div class="welcome__copy" data-reveal><p class="lead">Japanese precision. Brazilian warmth.<br class="desktop-break" /> Sushi, robata and dishes made for sharing.</p><p>NIPO takes its name from the Nipo-Brasileiro community of São Paulo, shaped by more than a century of Japanese migration to Brazil. On the Quayside, we celebrate that meeting of cultures through bold flavours and a generous welcome. We believe the best meals bring people closer.</p><a class="text-link" href="/concept/">Discover our concept</a></div>
    </section>
    <GalleryRail />
    <section class="photo-feature photo-feature--wide" aria-labelledby="home-menus-title">
      <Photo asset={photo("steak-salad")} /><div class="feature-veil"></div>
      <div class="photo-feature__copy" data-reveal><h2 id="home-menus-title">From sushi to the fire.</h2><p>Explore the food, drinks and wines of NIPO.</p><a class="button button--ivory" href="/menus/">Our menus</a></div>
    </section>
    <div class="paired-features">
      <a class="photo-feature" href="/concept/"><Photo asset={photo("fish-avocado-tartare")} sizes="(max-width:767px) 100vw, 50vw" /><div class="feature-veil"></div><div class="photo-feature__copy"><h2>The NIPO concept</h2><span class="text-link">Our story</span></div></a>
      <a class="photo-feature" href="/gallery/"><Photo asset={photo("sesame-tuna-bites")} sizes="(max-width:767px) 100vw, 50vw" /><div class="feature-veil"></div><div class="photo-feature__copy"><h2>A closer look</h2><span class="text-link">Explore the gallery</span></div></a>
    </div>
    <VipSignup />
  </main>
  <Lightbox />
</BaseLayout>
