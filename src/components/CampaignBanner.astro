---
import { blackFridayPromotion as campaign } from "../config/promotions";
---

<aside class="campaign-banner" data-campaign-banner aria-label="Black Friday voucher offer" hidden>
  <div class="campaign-banner__copy">
    <p><strong>{campaign.title}</strong> <span>{campaign.discount} {campaign.offer}*</span></p>
    <small>{campaign.terms}</small>
  </div>
  <a class="campaign-banner__link" href={campaign.href}>{campaign.cta}</a>
</aside>

<style>
  .campaign-banner { position:fixed; inset:0 0 auto; z-index:50; display:flex; justify-content:center; align-items:center; gap:32px; padding:10px 24px; background:var(--night-deep); color:var(--ivory); border-bottom:1px solid var(--gold); }
  .campaign-banner__copy p { margin:0; font-size:.875rem; line-height:1.5; }
  .campaign-banner__copy strong { color:var(--gold); font-weight:500; letter-spacing:.06em; margin-right:12px; }
  .campaign-banner__copy small { display:block; font-size:.75rem; line-height:1.5; color:var(--muted); }
  .campaign-banner__link { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; min-height:44px; padding:8px 20px; border:1px solid var(--gold); color:var(--gold); font-size:.875rem; line-height:1.4; }
  .campaign-banner__link:hover { background:var(--gold); color:var(--night); }
  .campaign-banner__link:focus-visible { outline-offset:3px; }
  @media(max-width:600px) {
    .campaign-banner { gap:12px; padding:10px 16px; }
    .campaign-banner__copy strong { display:block; margin-right:0; }
    .campaign-banner__copy p { font-size:.8125rem; }
    .campaign-banner__link { padding:8px 12px; }
  }
  @media(max-width:360px) {
    .campaign-banner { flex-wrap:wrap; justify-content:flex-start; gap:8px; }
  }
</style>
