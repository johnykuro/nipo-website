---
import type { SiteConfig } from "../config/site";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
---

<footer class="site-footer">
  <div class="section-shell footer__top">
    <h2>Follow NIPO</h2>
    <nav class="social-list" aria-label="Social media">
      {
        config.socialLinks.map((social) =>
          social.url ? (
            <a href={social.url} rel="noreferrer" target="_blank">
              <span>{social.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span aria-label={`${social.label} — account coming soon`}>
              <span>{social.label}</span>
              <small>Coming soon</small>
            </span>
          ),
        )
      }
    </nav>
  </div>

  <div class="section-shell footer__bottom">
    <img src="/brand/nipo-logo.svg" alt="NIPO" width="455" height="401" loading="lazy" />
    <p><strong>Coming Soon to {config.locationLabel}</strong></p>
    <p>
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true"> · </span>
      <span>© {new Date().getFullYear()} NIPO</span>
    </p>
  </div>
</footer>
