---
import type { SiteConfig } from "../config/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
---

<footer class="site-footer">
  <div class="section-shell footer__top">
    <h2>Follow NIPO</h2>
    <nav class="social-list" aria-label="Social media">
      {
        config.socialLinks.filter((social) => social.url).map((social) => (
            <a href={social.url} aria-label={`${social.label} (opens in a new tab)`} rel="noopener noreferrer" target="_blank">
              <SocialIcon platform={social.label} />
            </a>
          ))
      }
    </nav>
  </div>

  <div class="section-shell footer__bottom">
    <img src="/brand/nipo-logo.svg" alt="NIPO" width="455" height="401" loading="lazy" />
    <p><strong>Opening 23rd September on {config.locationLabel}</strong></p>
    <p>
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true"> · </span>
      <span>© {new Date().getFullYear()} NIPO</span>
    </p>
  </div>
</footer>
